      "name": "Buscar fichas",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Procura a proposta do pedido que o plugin pediu e devolve o plano para a prévia.\nconst id = String($('Pedir plano').first().json.query?.id || '').trim();\nif (!id) return [{ json: { ok: false, motivo: 'Faltou o código do pedido.' } }];\nconst linhas = $input.all().map(i => i.json).filter(r => r.pedido_id === id && r.plano);\nconst ultima = linhas[linhas.length - 1];\nif (!ultima) return [{ json: { ok: false, motivo: 'Ainda não há ficha para este pedido. A IA ainda está preparando a proposta, ou o fluxo 1 parou (veja a aba Executions).' } }];\nreturn [{ json: { ok: true, decidido: ultima.aprovado || 'pendente', plano: JSON.parse(ultima.plano) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "2eafdb62-95ba-4c9d-9b99-2387be4726ce",
      "name": "Montar resposta"
    },

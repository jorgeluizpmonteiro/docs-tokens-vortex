      "id": "48ff737c-b645-4891-9b9a-44b9063aa392",
      "name": "Receber decisão",
      "webhookId": "a38f7738-2d05-40ad-9184-1dbe5c450d50"
    },
    {
      "parameters": {
        "jsCode": "// Lê a decisão que o plugin mandou (Aplicar ou Recusar) para atualizar a linha do pedido na tabela.\nconst entrada = $input.first();\nlet corpo = entrada.json.body;\nif (typeof corpo === 'string') corpo = corpo.trim() ? JSON.parse(corpo) : null;\nif ((!corpo || !corpo.pedidoId) && entrada.binary) {\n  const chave = Object.keys(entrada.binary)[0];\n  if (chave) corpo = JSON.parse((await this.helpers.getBinaryDataBuffer(0, chave)).toString('utf8'));\n}\nif (!corpo || !corpo.pedidoId) throw new Error('A decisão chegou sem código do pedido. No Webhook, confira se Raw Body está ligado.');\nif (!['aplicado', 'recusado'].includes(corpo.decisao)) throw new Error(`Decisão desconhecida: ${corpo.decisao}`);\nreturn [{ json: { pedidoId: String(corpo.pedidoId), aprovado: corpo.decisao, minutos_revisao: Number(corpo.minutos) || 0 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        208
      ],
      "id": "1ffcdc89-8caf-4c9c-a3fb-3533a4f09b6e",
